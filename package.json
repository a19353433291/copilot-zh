{
  "name": "copilot-zh",
  "version": "0.2.0",
  "description": "GitHub Copilot Desktop 中文汉化工具（Windows）",
  "main": "electron/main.js",
  "author": "copilot-zh",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:dir": "electron-builder --win --dir",
    "build": "electron-builder --win nsis",
    "postinstall": "node scripts/check-env.js"
  },
  "build": {
    "appId": "com.copilotzh.desktop",
    "productName": "CopilotZh",
    "copyright": "copilot-zh",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "bundled-packs/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CopilotZh 汉化工具",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "bundled-packs",
        "to": "packs"
      }
    ]
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  }
}